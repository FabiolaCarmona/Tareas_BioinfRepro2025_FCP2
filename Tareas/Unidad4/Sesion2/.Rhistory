  "../Sesion2/DE_tutorial/YChrom_design.csv"
mydata <- read.delim(
  "../Sesion1/DE_tutorial/normdata.txt",
  as.is = TRUE,
  row.names = 1
)
design <- read.csv(
  "../Sesion1/DE_tutorial/YChrom_design.csv"
)
mydata <- read.delim(
  "../Sesion2/DE_tutorial/output/normdata.txt",
  as.is = TRUE,
  row.names = 1
)
mydata <- read.delim(
  "output/normdata.txt",
  as.is     = TRUE,
  row.names = 1
)
design <- read.csv("YChrom_design.csv")
dim(mydata)
head(mydata[, 1:4])
head(design)
d_euc  <- dist(t(mydata), method = "euclidean")
hc_euc <- hclust(d_euc, method = "complete")
png("hclust_euclid_samples.png", width = 600, height = 500)
plot(hc_euc,
     main = "Clustering jerárquico de muestras (distancia euclidiana)",
     xlab = "Muestras", sub = "")
dev.off()
cor_mat    <- cor(mydata, method = "pearson")
d_pearson  <- as.dist(1 - cor_mat)
hc_pearson <- hclust(d_pearson, method = "complete")
png("hclust_pearson_samples.png", width = 600, height = 500)
plot(hc_pearson,
     main = "Clustering jerárquico de muestras (1 - correlación de Pearson)",
     xlab = "Muestras", sub = "")
dev.off()
groups <- factor(design$Group)
cols   <- as.numeric(groups)
png("hclust_euclid_samples_colored.png", width = 600, height = 500)
plot(hc_euc,
     main = "Clustering jerárquico (euclidiano)",
     xlab = "Muestras", sub = "",
     labels = design$Sample_Name)
lab <- par("usr")[3] - 0.02 * diff(par("usr")[3:4])
text(seq_along(hc_euc$labels), lab,
     labels = hc_euc$labels, col = cols, xpd = TRUE, srt = 90, adj = 1)
dev.off()
d_euc_genes  <- dist(mydata, method = "euclidean")
hc_euc_genes <- hclust(d_euc_genes, method = "complete")
png("hclust_euclid_genes.png", width = 600, height = 500)
plot(hc_euc_genes,
     main = "Clustering jerárquico de sondas (euclidiana)",
     xlab = "Sondas", sub = "", labels = FALSE)
dev.off()
cor_genes       <- cor(t(mydata), method = "pearson")
d_pearson_genes <- as.dist(1 - cor_genes)
hc_pearson_genes <- hclust(d_pearson_genes, method = "complete")
png("hclust_pearson_genes.png", width = 600, height = 500)
plot(hc_pearson_genes,
     main = "Clustering jerárquico de sondas (1 - Pearson)",
     xlab = "Sondas", sub = "", labels = FALSE)
dev.off()
set.seed(123)
wss_samples <- numeric(10)
for (k in 1:10) {
  km <- kmeans(t(mydata), centers = k, nstart = 20)
  wss_samples[k] <- km$tot.withinss
}
png("SSQ_by_K_using_kmeans_samples.png", width = 600, height = 500)
plot(1:10, wss_samples, type = "b", pch = 19,
     xlab = "Número de clusters (k)",
     ylab = "Suma de cuadrados intra-cluster",
     main = "Método del codo – muestras")
dev.off()
set.seed(123)
wss_genes <- numeric(10)
for (k in 1:10) {
  km <- kmeans(mydata, centers = k, nstart = 20)
  wss_genes[k] <- km$tot.withinss
}
png("SSQ_by_K_using_kmeans_genes.png", width = 600, height = 500)
plot(1:10, wss_genes, type = "b", pch = 19,
     xlab = "Número de clusters (k)",
     ylab = "Suma de cuadrados intra-cluster",
     main = "Método del codo – sondas")
dev.off()
k_samples <- 3
k_genes   <- 3
clusters_samples <- cutree(hc_euc,        k = k_samples)
clusters_genes   <- cutree(hc_euc_genes,  k = k_genes)
# Muestras
png("rect_hclust_samples_k3.png", width = 600, height = 500)
plot(hc_euc,
     main = "Dendrograma de muestras (euclidiana, k = 3)",
     xlab = "Muestras", sub = "")
rect.hclust(hc_euc, k = k_samples, border = 2:(k_samples + 1))
dev.off()
# Sondas
png("rect_hclust_genes_k3.png", width = 600, height = 500)
plot(hc_euc_genes,
     main = "Dendrograma de sondas (euclidiana, k = 3)",
     xlab = "Sondas", sub = "", labels = FALSE)
rect.hclust(hc_euc_genes, k = k_genes, border = 2:(k_genes + 1))
dev.off()
q()
